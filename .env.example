# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# The council (AI agents)
# ---------------------------------------------------------------------------

# Vercel AI Gateway key. Without it the agents run on scripted rules instead of AI models.
AI_GATEWAY_API_KEY=

# Model behind each agent, as listed at https://ai-gateway.vercel.sh/v1/models
COUNCIL_MODEL_QUANT=openai/gpt-6-astra
COUNCIL_MODEL_GUARDIAN=anthropic/claude-opus-4.8
COUNCIL_MODEL_DEGEN=spacexai/grok-4.7
COUNCIL_MODEL_ORACLE=typesafe-ai/jev

# Seconds between council sessions. Each session costs roughly $0.10 to $0.20 in model calls.
COUNCIL_INTERVAL_SECONDS=300

# Most sessions run on AI models per UTC day. After that the agents fall back to scripted rules.
COUNCIL_MAX_ROUNDS_PER_DAY=100

# ---------------------------------------------------------------------------
# Arena Rewards
# ---------------------------------------------------------------------------
#
# With no TREASURY_SECRET_KEY the claim page runs in demo mode: the wallet
# signature is verified, but no USDC is sent.

# "devnet" (default) or "mainnet-beta". Test on devnet first.
SOLANA_CLUSTER=devnet

# Optional. Defaults to the public RPC, which is rate limited; use Helius or similar in production.
SOLANA_RPC_URL=

# Secret key of the wallet that pays rewards. Either the JSON array from
# `solana-keygen new` or a base58 key exported from a wallet.
# This wallet needs USDC for the rewards and a little SOL for fees and token-account rent.
# Keep only a day's budget in it.
TREASURY_SECRET_KEY=

# Any long random string. Required in production so sign-in requests survive restarts.
CLAIM_SECRET=

# USDC paid per claim.
REWARD_USDC=1.5

# Most claims paid per UTC day, across all users.
DAILY_CLAIM_CAP=100

# Most claims per IP address per UTC day.
IP_DAILY_LIMIT=3

# Wallet must have at least this many past transactions. Defaults: 0 on devnet, 5 on mainnet.
MIN_WALLET_TXS=

# Optional Cloudflare Turnstile captcha. Set both to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
