# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# The council (AI agents)
# ---------------------------------------------------------------------------

# Vercel AI Gateway key. Without it the agents run on scripted rules instead of AI models.
AI_GATEWAY_API_KEY=

# Model behind each agent, as listed at https://ai-gateway.vercel.sh/v1/models
COUNCIL_MODEL_QUANT=openai/gpt-6-sol
COUNCIL_MODEL_GUARDIAN=anthropic/claude-opus-5.5
COUNCIL_MODEL_DEGEN=alibaba/qwen3.8-max
# Agents that are given Jev's odds to weigh before they decide, by their keys. The model still decides.
# COUNCIL_ODDS_FOR=degen
COUNCIL_MODEL_ORACLE=typesafe-ai/jev

# Seconds between council sessions. Each session costs roughly $0.10 to $0.20 in model calls.
COUNCIL_INTERVAL_SECONDS=300

# Most sessions run on AI models per UTC day. After that the agents fall back to scripted rules.
COUNCIL_MAX_ROUNDS_PER_DAY=100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string (Neon). Server-side only: never expose it to client code.
# Without it the council's state is kept in a local file, and funding is switched off.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Robinhood Chain
# ---------------------------------------------------------------------------

# "testnet" (default, chain 46630) or "mainnet" (chain 4663). Both settings must say the same.
ROBINHOOD_NETWORK=testnet
NEXT_PUBLIC_ROBINHOOD_NETWORK=testnet

# Optional. Default to the public endpoints, which are rate limited; use a provider such as Alchemy in production.
ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# Private key (0x...) of the wallet that pays rewards, bonuses and withdrawals.
# It needs USDG to pay out and a little ETH for network fees. Keep only a day's budget in it.
# Without it, funding is off and the claim page runs in demo mode.
TREASURY_PRIVATE_KEY=

# The funding token. On mainnet it defaults to USDG. On the testnet, run
#   node --env-file=.env.local scripts/setup-testnet.mjs
# once the treasury holds some testnet ETH. It deploys a test USDG and sets this.
USDG_ADDRESS=

# Optional. The agents' desk contracts: each agent has one, which holds its USDG and records its trades.
# DESK_SHARES issues the receipts for their positions.
# Set by:  node --env-file=.env.local scripts/deploy-desks.mjs
# Without them the desk's trades are kept in its books, with no transaction to show.
DESK_QUANT=
DESK_DEGEN=
DESK_GUARDIAN=
DESK_ORACLE=
DESK_SHARES=
DESK_FROM_BLOCK=

# Optional. A free project ID from https://cloud.reown.com lets Robinhood Wallet, a phone app, connect by QR code.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Funding an agent
# ---------------------------------------------------------------------------
# Needs DATABASE_URL, TREASURY_PRIVATE_KEY and, on the testnet, USDG_ADDRESS.

# Lets users get free test tokens from the app. Testnet only.
FAUCET_ENABLED=true
FAUCET_AMOUNT=100

# Hours a first deposit must stay in before its bonus is paid. Withdrawing earlier forfeits it.
# 0 pays at once: fine for a demo, but it lets anyone farm the bonus with new wallets.
BONUS_LOCK_HOURS=168

# Most bonus money promised per UTC day.
BONUS_DAILY_BUDGET_USD=50

# Route fee on withdrawal: the larger of these two.
WITHDRAW_FEE_MIN_USD=1
WITHDRAW_FEE_PCT=2

FUND_MIN_DEPOSIT=5
FUND_MAX_DEPOSIT=500

# Taking real deposits is a custody business with legal duties. Funding refuses to run on
# mainnet unless this is "true".
ALLOW_MAINNET_FUNDING=false

# ---------------------------------------------------------------------------
# Trade requests
# ---------------------------------------------------------------------------
# With a deposit, a funder may ask the agent to trade a token on Robinhood Chain:
# a Robinhood Stock Token by symbol, or any other token by its contract address.

# A request funded with at least this much commits the agent to the trade.
# Below it, the agent presents the request and the council votes.
REQUEST_COMMIT_FROM_USD=20

# The board: the trending tokens the agents choose from. How many, and what a token's pool must show to be on it.
# BOARD_LAUNCHPAD is where they come from: pons (the default) for tokens launched on Pons only, any for the whole chain.
# BOARD_LAUNCHPAD=pons
# BOARD_SIZE=8
# BOARD_MIN_LIQUIDITY_USD=30000
# BOARD_MIN_VOLUME_USD=100000
# BOARD_MIN_AGE_HOURS=6

# What the trading pool of a token a funder asks for must show before the desk will trade it.
# Left out, any token that traded in the last day can be asked for on the testnet,
# and on mainnet the floors are 50000, 10000 and 24.
# REQUEST_MIN_LIQUIDITY_USD=50000
# REQUEST_MIN_VOLUME_USD=10000
# REQUEST_MIN_AGE_HOURS=24

# Where token symbols are read from when a requested address has no market. Robinhood Chain's public RPC if left out.
# ROBINHOOD_MAINNET_RPC_URL=

# ---------------------------------------------------------------------------
# The admin's display (/admin)
# ---------------------------------------------------------------------------
# One account. Make all three with:  node scripts/admin-password.mjs --out .data/admin.env
# Without them nobody can sign in.

ADMIN_USERNAME=
# A hash of the password, never the password itself.
ADMIN_PASSWORD_HASH=
# Signs the cookie of a signed-in browser. At least 32 characters. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Arena Rewards
# ---------------------------------------------------------------------------
# With no TREASURY_PRIVATE_KEY the claim page runs in demo mode: the wallet
# signature is verified, but no USDG is sent.

# Any long random string. Required in production so sign-in requests survive restarts.
CLAIM_SECRET=

# USDG paid per claim.
REWARD_USDG=1.5

# Most claims paid per UTC day, across all users.
DAILY_CLAIM_CAP=100

# Most claims per IP address per UTC day.
IP_DAILY_LIMIT=3

# Wallet must have at least this many past transactions. Defaults: 0 on the testnet, 5 on mainnet.
MIN_WALLET_TXS=

# Optional Cloudflare Turnstile captcha. Set both to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
